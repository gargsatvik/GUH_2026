# Copy to .env.local. Everything is optional for a local preview:
# with nothing set, the app runs on an in-memory store with the seed data.

# Supabase (section 10). Set all three to use Supabase instead of the in-memory store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (section 15). Without a key, the instant pattern match and a template report are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ElevenLabs (section 14). Without these, use replay mode or type caller lines on /caller.
ELEVENLABS_API_KEY=
ELEVENLABS_DECOY_AGENT_ID=
ELEVENLABS_PROTECT_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# n8n (section 16). When N8N_ENABLED is not "true", the same steps run inline.
N8N_ENABLED=false
N8N_WEBHOOK_INTEL_URL=
N8N_WEBHOOK_SESSION_ENDED_URL=
N8N_WEBHOOK_CANARY_URL=
N8N_WEBHOOK_ALLY_URL=
N8N_SHARED_SECRET=

APP_BASE_URL=http://localhost:3000
DEMO_SESSION_ID=demo
