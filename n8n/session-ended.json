{
  "name": "session-ended",
  "nodes": [
    {
      "id": "1db1e690-4cd9-45ea-83b1-9377b20c8c8a",
      "name": "Call ended",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "0369958a-bdfc-4059-8393-2228c7532ddc",
      "parameters": {
        "httpMethod": "POST",
        "path": "decoy-session-ended",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "0eca4d0d-2eac-4bca-866b-ed69976887f2",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        200
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "a1d6b194-4863-4331-8f1e-3b5374c83b1c",
              "name": "APP_BASE_URL",
              "value": "https://YOUR-APP.vercel.app",
              "type": "string"
            },
            {
              "id": "50c32058-83b4-4fa7-b77c-16c6c8373f4a",
              "name": "DECOY_SECRET",
              "value": "PASTE N8N_SHARED_SECRET",
              "type": "string"
            },
            {
              "id": "b990e45b-58bd-4da9-b4c3-3bf7801bef5d",
              "name": "CHAT_WEBHOOK_URL",
              "value": "",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "0f0a9808-f4e8-4022-8102-1f55dd1311ac",
      "name": "Write report (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        200
      ],
      "notes": "The app writes the report with Claude (template if no Anthropic key is set).",
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.APP_BASE_URL }}/api/actions/draft-report",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-decoy-secret",
              "value": "={{ $('Config').item.json.DECOY_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Call ended').item.json.body) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "c6f6f7a4-4612-424d-851a-719a0f2fc67d",
      "name": "Save report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.APP_BASE_URL }}/api/actions/report",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-decoy-secret",
              "value": "={{ $('Config').item.json.DECOY_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ callId: $('Call ended').item.json.body.callId, title: $json.title, bodyMd: $json.bodyMd, sentTo: 'Fraud Operations' }) }}",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "bf8d7ac1-d7f0-45ef-ab17-2e8993a08ef2",
      "name": "Share report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.CHAT_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: 'Fraud report ready: ' + $('Write report (Claude)').item.json.title + '. ' + $('Config').item.json.APP_BASE_URL + '/ops/reports/' + $json.id, text: 'Fraud report ready: ' + $('Write report (Claude)').item.json.title + '. ' + $('Config').item.json.APP_BASE_URL + '/ops/reports/' + $json.id }) }}",
        "options": {}
      },
      "onError": "continueRegularOutput",
      "notes": "Optional. Posts to the #fraud-ops Discord or Slack channel set in Config."
    }
  ],
  "connections": {
    "Call ended": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Write report (Claude)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write report (Claude)": {
      "main": [
        [
          {
            "node": "Save report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save report": {
      "main": [
        [
          {
            "node": "Share report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}