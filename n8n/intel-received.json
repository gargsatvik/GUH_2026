    {
      "id": "a1654397-442c-4c80-9b8e-2b97384918d8",
      "name": "Is it an account?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "052e8947-652e-439b-bb47-3291c3a118fd",
              "leftValue": "={{ $json.kind }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "account"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "82e32fdf-d901-4f0b-a755-08d22da08f19",
      "name": "Block account",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.APP_BASE_URL }}/api/actions/flag-account",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-decoy-secret",
              "value": "={{ $('Config').item.json.DECOY_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ entityId: $json.id, callId: $('Intel received').item.json.body.callId, reason: 'Named as the payee by a caller on the Decoy line' }) }}",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "c4a52a05-5154-49d7-a6e8-f1fb0e7e9bd6",
      "name": "Note detail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.APP_BASE_URL }}/api/actions/timeline",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-decoy-secret",
              "value": "={{ $('Config').item.json.DECOY_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ callId: $('Intel received').item.json.body.callId, kind: 'capture', title: $json.kind === 'phone' ? 'Added ' + $json.display + ' to the scam number list' : $json.kind === 'url' ? 'Added link to the suspicious sites list' : $json.kind === 'wallet' ? 'Recorded wallet' : 'Recorded caller name', detail: $json.kind === 'phone' ? null : $json.display }) }}",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "7040284d-78c5-4e1d-8a8f-574e262cb438",
      "name": "Tell Fraud Operations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.CHAT_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: 'New scam account blocked: ' + $('Is it an account?').item.json.display + ($('Is it an account?').item.json.label ? ' (' + $('Is it an account?').item.json.label + ')' : '') + '.' + ($('Intel received').item.json.body.suggestedCampaign ? ' Linked to ' + $('Intel received').item.json.body.suggestedCampaign.name + ($('Intel received').item.json.body.matches[0] ? ' through ' + $('Intel received').item.json.body.matches[0].display : '') + '.' : '') + ' Live call in progress.', text: 'New scam account blocked: ' + $('Is it an account?').item.json.display + ($('Is it an account?').item.json.label ? ' (' + $('Is it an account?').item.json.label + ')' : '') + '.' + ($('Intel received').item.json.body.suggestedCampaign ? ' Linked to ' + $('Intel received').item.json.body.suggestedCampaign.name + ($('Intel received').item.json.body.matches[0] ? ' through ' + $('Intel received').item.json.body.matches[0].display : '') + '.' : '') + ' Live call in progress.' }) }}",
        "options": {}
      }
    },
    {
      "id": "60d048ce-b08c-40e2-a838-5cda930b7fe7",
      "name": "Any matches?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
